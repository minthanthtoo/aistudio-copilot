{
  "manifest_version": 3,
  "name": "AI Studio Queue Pilot",
  "version": "0.3.0",
  "description": "Reliable prompt queues, state-aware submission, retry recovery, and ZIP export for Google AI Studio Apps.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://aistudio.google.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Toggle AI Studio Queue Pilot",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Toggle Queue Pilot"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["src/core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
